{
  "$schema": "https://keyfactor.github.io/v2/integration-manifest-schema.json",
  "integration_type": "orchestrator",
  "name": "Mobotix IP Camera",
  "status": "pilot",
  "support_level": "kf-supported",
  "link_github": true,
  "update_catalog": true,
  "description": "The Mobotix IP Camera Orchestrator Extension is used to inventory and enroll the TLS certificate associated with the camera's web server.",
  "release_dir": "MobotixIPCamera\\bin\\Release",
  "release_project":"MobotixIPCamera\\MobotixIPCamera.csproj",
  "about": {
    "orchestrator": {
      "UOFramework": "25.4",
      "keyfactor_platform_version": "25.4",
      "pam_support": false,
      "store_types": [
